{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=StargateDB;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.MSSqlServer"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj} <CorrelationId:{CorrelationId}>{NewLine}{Exception}"
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "DefaultConnection",
          "tableName": "LogEntry",
          "autoCreateSqlTable": false,
          "restrictedToMinimumLevel": "Information",
          "columnOptionsSection": {
            "disableTriggers": false,
            "clusteredColumnstoreIndex": false,
            "primaryKeyColumnName": "Id",
            "addStandardColumns": [],
            "removeStandardColumns": [
              "Properties",
              "MessageTemplate",
              "LogEvent"
            ],
            "customColumns": [
              {
                "ColumnName": "Category",
                "DataType": "nvarchar",
                "DataLength": 255,
                "AllowNull": false
              },
              {
                "ColumnName": "Source",
                "DataType": "nvarchar",
                "DataLength": 255,
                "AllowNull": true
              },
              {
                "ColumnName": "CorrelationId",
                "DataType": "nvarchar",
                "DataLength": 50,
                "AllowNull": true
              },
              {
                "ColumnName": "UserId",
                "DataType": "nvarchar",
                "DataLength": 100,
                "AllowNull": true
              },
              {
                "ColumnName": "RequestPath",
                "DataType": "nvarchar",
                "DataLength": 500,
                "AllowNull": true
              },
              {
                "ColumnName": "RequestMethod",
                "DataType": "nvarchar",
                "DataLength": 10,
                "AllowNull": true
              },
              {
                "ColumnName": "StatusCode",
                "DataType": "int",
                "AllowNull": true
              },
              {
                "ColumnName": "ElapsedMilliseconds",
                "DataType": "bigint",
                "AllowNull": true
              },
              {
                "ColumnName": "AdditionalData",
                "DataType": "nvarchar",
                "DataLength": 4000,
                "AllowNull": true
              },
              {
                "ColumnName": "StackTrace",
                "DataType": "nvarchar",
                "DataLength": 4000,
                "AllowNull": true
              }
            ],
            "id": {
              "columnName": "Id",
              "nonClusteredIndex": false
            },
            "level": {
              "columnName": "Level",
              "storeAsEnum": false
            },
            "timeStamp": {
              "columnName": "Timestamp",
              "convertToUtc": true
            },
            "message": {
              "columnName": "Message"
            },
            "exception": {
              "columnName": "Exception",
              "dataLength": 4000
            }
          }
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*"
}
